local surukle, baslangic, baslangicPos
UstBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        surukle = true
        baslangic = input.Position
        baslangicPos = AnaFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then surukle = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if surukle and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - baslangic
        AnaFrame.Position = UDim2.new(baslangicPos.X.Scale, baslangicPos.X.Offset + delta.X, baslangicPos.Y.Scale, baslangicPos.Y.Offset + delta.Y)
    end
end)

