-- ESP
RunService.RenderStepped:Connect(function()
    pcall(function()
        for _, oyuncu in pairs(Players:GetPlayers()) do
            if oyuncu ~= LocalPlayer and oyuncu.Character then
                local highlight = oyuncu.Character:FindFirstChild("BEST_ESP")
                if State.ESP_Aktif then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "BEST_ESP"
                        highlight.FillColor = Renkler.Pembe
                        highlight.FillTransparency = 0.5
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.Parent = oyuncu.Character
                    end
                else
                    if highlight then highlight:Destroy() end
                end
            end
        end
    end)
end)

-- Aimbot & Murderer Kontrolü (Güvenli Düzeltme)
RunService.RenderStepped:Connect(function()
    pcall(function()
        if (State.CameraAimbot or State.CrosshairAimbot) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
            local enYakin, enKisaMesafe = nil, State.FOV * 10
            local cam = workspace.CurrentCamera
            
            for _, oyuncu in pairs(Players:GetPlayers()) do
                if oyuncu ~= LocalPlayer and oyuncu.Character and oyuncu.Character:FindFirstChild("Head") then
                    
                    -- Katil Kontrolü (Karakter üzerinde bıçak arama)
                    local hedefGecerli = true
                    if State.OnlyMurderer then
                        local hasKnife = oyuncu.Character:FindFirstChild("Knife") or (oyuncu.Character:FindFirstChildOfClass("Tool") and oyuncu.Character:FindFirstChildOfClass("Tool").Name == "Knife")
                        if not hasKnife then hedefGecerli = false end
                    end
                    
                    if hedefGecerli then
                        local head = oyuncu.Character.Head
                        local mesafe = (head.Position - LocalPlayer.Character.Head.Position).Magnitude
                        
                        -- Modern Raycast Kontrolü
                        local wallHit = false
                        if State.WallCheck then
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, oyuncu.Character}
                            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                            
                            local result = workspace:Raycast(cam.CFrame.Position, (head.Position - cam.CFrame.Position), raycastParams)
                            if result then wallHit = true end
                        end
                        
                        if not wallHit and mesafe < enKisaMesafe then
                            enKisaMesafe = mesafe
                            enYakin = head
                        end
                    end
                end
            end
            
            if enYakin and State.CameraAimbot then
                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, enYakin.Position)
            end
        end
    end)
end)

-- Fly
local flyBV = nil
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart

        if State.FlyAktif then
            if not flyBV or flyBV.Parent ~= hrp then
                if hrp:FindFirstChild("BEST_Fly") then hrp.BEST_Fly:Destroy() end
                flyBV = Instance.new("BodyVelocity")
                flyBV.Name = "BEST_Fly"
                flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                flyBV.Parent = hrp
            end
            local cam = workspace.CurrentCamera
            local moveDir = Vector3.new(0,0,0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
            
            flyBV.Velocity = moveDir * 50
        else
            if hrp:FindFirstChild("BEST_Fly") then hrp.BEST_Fly:Destroy() end
            flyBV = nil
        end
    end)
end)

