-- ESP
table.insert(NYR_System.conns, RunService.RenderStepped:Connect(function()
    pcall(function()
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer and v.Character then
                local h = v.Character:FindFirstChild("NYR_ESP")
                if State.ESP_Aktif then
                    if not h then
                        h = Instance.new("Highlight")
                        h.Name = "NYR_ESP"
                        h.FillColor = Renkler.Pembe
                        h.Parent = v.Character
                    end
                else
                    if h then h:Destroy() end
                end
            end
        end
    end)
end))

-- AIMBOT
table.insert(NYR_System.conns, RunService.RenderStepped:Connect(function()
    pcall(function()
        if (State.CameraAimbot or State.CrosshairAimbot) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
            local target = nil
            local dist = 500
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Head") then
                    local head = v.Character.Head
                    local d = (head.Position - LocalPlayer.Character.Head.Position).Magnitude
                    if d < dist then
                        dist = d
                        target = head
                    end
                end
            end
            if target and State.CameraAimbot then
                workspace.CurrentCamera.CFrame = CFrame.lookAt(workspace.CurrentCamera.CFrame.Position, target.Position)
            end
        end
    end)
end))

-- FLY
local flyBV
table.insert(NYR_System.conns, RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart

        if State.FlyAktif then
            if not flyBV or flyBV.Parent ~= hrp then
                flyBV = Instance.new("BodyVelocity")
                flyBV.Name = "NYR_Fly"
                flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                flyBV.Parent = hrp
            end
            flyBV.Velocity = workspace.CurrentCamera.CFrame.LookVector * 50
        else
            if hrp:FindFirstChild("NYR_Fly") then hrp.NYR_Fly:Destroy() end
            flyBV = nil
        end
    end)
end))

