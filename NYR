local Sekmeler = {}
local function SekmeEkle(isim, ikon, sira)
    local Btn = YeniObje("TextButton", {
        Size = UDim2.new(1, -30, 0, 45), Position = UDim2.new(0, 15, 0, 80 + (sira * 50)),
        BackgroundColor3 = Renkler.SolMenuArka, Text = "", BorderSizePixel = 0, AutoButtonColor = false
    }, SolMenu)
    YeniObje("UICorner", {CornerRadius = UDim.new(0, 6)}, Btn)
    
    local Cizgi = YeniObje("Frame", {
        Size = UDim2.new(0, 4, 1, -10), Position = UDim2.new(0, 0, 0, 5),
        BackgroundColor3 = Renkler.Pembe, Visible = false, BorderSizePixel = 0
    }, Btn)
    YeniObje("UICorner", {CornerRadius = UDim.new(1, 0)}, Cizgi)

    local IkonLbl = YeniObje("TextLabel", {
        Size = UDim2.new(0, 30, 1, 0), Position = UDim2.new(0, 15, 0, 0),
        BackgroundTransparency = 1, Text = ikon, TextColor3 = Renkler.GriYazı, TextSize = 18, Font = Enum.Font.Gotham
    }, Btn)

    local Txt = YeniObje("TextLabel", {
        Size = UDim2.new(1, -50, 1, 0), Position = UDim2.new(0, 50, 0, 0),
        BackgroundTransparency = 1, Text = isim, TextColor3 = Renkler.GriYazı,
        TextSize = 14, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left
    }, Btn)

    local Sayfa = YeniObje("ScrollingFrame", {
        Size = UDim2.new(1, -50, 1, -80), Position = UDim2.new(0, 25, 0, 70),
        BackgroundTransparency = 1, Visible = false, ScrollBarThickness = 0, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y
    }, Icerik)
    YeniObje("UIListLayout", {Padding = UDim.new(0, 8)}, Sayfa)

    Sekmeler[isim] = {Buton = Btn, Cizgi = Cizgi, Yazı = Txt, Ikon = IkonLbl, Sayfa = Sayfa}

    Btn.MouseButton1Click:Connect(function()
        for _, s in pairs(Sekmeler) do
            s.Sayfa.Visible = false; s.Cizgi.Visible = false
            s.Yazı.TextColor3 = Renkler.GriYazı; s.Ikon.TextColor3 = Renkler.GriYazı
            TweenService:Create(s.Buton, TweenInfo.new(0.15), {BackgroundColor3 = Renkler.SolMenuArka}):Play()
        end
        Sayfa.Visible = true; Cizgi.Visible = true
        Txt.TextColor3 = Renkler.Yazı; IkonLbl.TextColor3 = Renkler.Yazı
        IcerikBaslik.Text = isim
        TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Renkler.AktifSekmeArka}):Play()
    end)
    return Sayfa
end

-- ═══ ÇALIŞAN MODERN SWITCH ═══
local function SwitchEkle(ebeveyn, isim, aciklama, callback)
    local Kutu = YeniObje("Frame", {
        Size = UDim2.new(1, -10, 0, 55), BackgroundColor3 = Renkler.KutuArka, BorderSizePixel = 0
    }, ebeveyn)
    YeniObje("UICorner", {CornerRadius = UDim.new(0, 6)}, Kutu)

    YeniObje("TextLabel", {
        Size = UDim2.new(0.75, 0, 0, 20), Position = UDim2.new(0, 15, 0, 10),
        BackgroundTransparency = 1, Text = isim, TextColor3 = Renkler.Yazı,
        TextSize = 13, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left
    }, Kutu)

    YeniObje("TextLabel", {
        Size = UDim2.new(0.75, 0, 0, 15), Position = UDim2.new(0, 15, 0, 30),
        BackgroundTransparency = 1, Text = aciklama, TextColor3 = Renkler.GriYazı,
        TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left
    }, Kutu)

    YeniObje("TextLabel", {
        Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(1, -90, 0.5, -10),
        BackgroundTransparency = 1, Text = "-", TextColor3 = Renkler.GriYazı,
        TextSize = 16, Font = Enum.Font.GothamBold
    }, Kutu)

    local Btn = YeniObje("TextButton", {
        Size = UDim2.new(0, 45, 0, 22), Position = UDim2.new(1, -55, 0.5, -11),
        BackgroundColor3 = Renkler.SwitchKapali, Text = "", BorderSizePixel = 0
    }, Kutu)
    YeniObje("UICorner", {CornerRadius = UDim.new(1, 0)}, Btn)

    local Yuvarlak = YeniObje("Frame", {
        Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(200,200,200), BorderSizePixel = 0
    }, Btn)
    YeniObje("UICorner", {CornerRadius = UDim.new(1, 0)}, Yuvarlak)

    local aktif = false
    Btn.MouseButton1Click:Connect(function()
        aktif = not aktif
        if aktif then
            TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Renkler.Pembe}):Play()
            TweenService:Create(Yuvarlak, TweenInfo.new(0.2), {Position = UDim2.new(1, -19, 0.5, -8), BackgroundColor3 = Color3.fromRGB(255,255,255)}):Play()
        else
            TweenService:Create(Btn, TweenInfo.new(0.2), {BackgroundColor3 = Renkler.SwitchKapali}):Play()
            TweenService:Create(Yuvarlak, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -8), BackgroundColor3 = Color3.fromRGB(200,200,200)}):Play()
        end
        if callback then callback(aktif) end
    end)
end

