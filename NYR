    YeniObje("UICorner", {CornerRadius = UDim.new(0, 8)}, Btn)

    local IkonLbl = YeniObje("TextLabel", {
        Size = UDim2.new(0, 30, 1, 0), Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1, Text = ikon, TextColor3 = Renkler.GriYazı, TextSize = 15, Font = Enum.Font.Gotham
    }, Btn)

    local Txt = YeniObje("TextLabel", {
        Size = UDim2.new(1, -45, 1, 0), Position = UDim2.new(0, 40, 0, 0),
        BackgroundTransparency = 1, Text = isim, TextColor3 = Renkler.GriYazı,
        TextSize = 13, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left
    }, Btn)

    local Sayfa = YeniObje("ScrollingFrame", {
        Size = UDim2.new(1, -40, 1, -55), Position = UDim2.new(0, 20, 0, 45),
        BackgroundTransparency = 1, Visible = false, ScrollBarThickness = 2, ScrollBarImageColor3 = Renkler.Pembe,
        CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y
    }, Icerik)
    YeniObje("UIListLayout", {Padding = UDim.new(0, 8)}, Sayfa)

    Sekmeler[isim] = {Buton = Btn, Yazı = Txt, Ikon = IkonLbl, Sayfa = Sayfa}

    Btn.MouseButton1Click:Connect(function()
        for _, s in pairs(Sekmeler) do
            s.Sayfa.Visible = false
            s.Yazı.TextColor3 = Renkler.GriYazı
            s.Ikon.TextColor3 = Renkler.GriYazı
            TweenService:Create(s.Buton, TweenInfo.new(0.15), {BackgroundColor3 = Renkler.SolMenuArka}):Play()
        end
        Sayfa.Visible = true
        Txt.TextColor3 = Renkler.Yazı
        IkonLbl.TextColor3 = Renkler.Yazı
        BaslikYazi.Text = isim
        TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Renkler.AktifSekmeArka}):Play()
    end)
    return Sayfa
end

