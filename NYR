-- ═══ SEKME SİSTEMİ ═══
local Sekmeler = {}
local function SekmeEkle(isim, ikon, sira)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -20, 0, 38)
    Btn.Position = UDim2.new(0, 10, 0, 60 + (sira * 44))
    Btn.BackgroundColor3 = Renkler.SolMenuArka
    Btn.Text = ""
    Btn.BorderSizePixel = 0
    Btn.Parent = SolMenu

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = Btn

    local Txt = Instance.new("TextLabel")
    Txt.Size = UDim2.new(1, -20, 1, 0)
    Txt.Position = UDim2.new(0, 12, 0, 0)
    Txt.BackgroundTransparency = 1
    Txt.Text = ikon .. "   " .. isim
    Txt.TextColor3 = Renkler.GriYazı
    Txt.TextSize = 12
    Txt.Font = Enum.Font.GothamMedium
    Txt.TextXAlignment = Enum.TextXAlignment.Left
    Txt.Parent = Btn

    local Sayfa = Instance.new("ScrollingFrame")
    Sayfa.Size = UDim2.new(1, -35, 1, -55)
    Sayfa.Position = UDim2.new(0, 20, 0, 45)
    Sayfa.BackgroundTransparency = 1
    Sayfa.Visible = false
    Sayfa.ScrollBarThickness = 2
    Sayfa.ScrollBarImageColor3 = Renkler.Pembe
    Sayfa.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Sayfa.Parent = Icerik

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.Parent = Sayfa

    Sekmeler[isim] = {Buton = Btn, Yazı = Txt, Sayfa = Sayfa}

    Btn.MouseButton1Click:Connect(function()
        for _, s in pairs(Sekmeler) do
            s.Sayfa.Visible = false
            s.Yazı.TextColor3 = Renkler.GriYazı
            s.Buton.BackgroundColor3 = Renkler.SolMenuArka
        end
        Sayfa.Visible = true
        Txt.TextColor3 = Renkler.Yazı
        Btn.BackgroundColor3 = Renkler.AktifSekmeArka
        BaslikYazi.Text = isim
    end)
    return Sayfa
end

