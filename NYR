-- ESP
RunService.RenderStepped:Connect(function()
    for _, oyuncu in pairs(Players:GetPlayers()) do
        if oyuncu ~= LP and oyuncu.Character then
            local highlight = oyuncu.Character:FindFirstChild("NYR_ESP")
            if State.ESP_Aktif then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "NYR_ESP"
                    highlight.FillColor = Color3.fromRGB(255, 50, 50)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.Parent = oyuncu.Character
                end
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
end)

-- Fly
local flyBaglanti
local function FlyGuncelle(a)
    State.FlyAktif = a
    if a and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local BV = Instance.new("BodyVelocity", LP.Character.HumanoidRootPart)
        BV.Name = "NYR_Fly"
        BV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        flyBaglanti = RunService.RenderStepped:Connect(function()
            BV.Velocity = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then BV.Velocity = BV.Velocity + workspace.CurrentCamera.CFrame.LookVector * State.Hiz end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then BV.Velocity = BV.Velocity - workspace.CurrentCamera.CFrame.LookVector * State.Hiz end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then BV.Velocity = BV.Velocity - workspace.CurrentCamera.CFrame.RightVector * State.Hiz end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then BV.Velocity = BV.Velocity + workspace.CurrentCamera.CFrame.RightVector * State.Hiz end
        end)
    else
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character.HumanoidRootPart:FindFirstChild("NYR_Fly") then 
            LP.Character.HumanoidRootPart.NYR_Fly:Destroy() 
        end
        if flyBaglanti then flyBaglanti:Disconnect() end
    end
end

-- Noclip
RunService.Stepped:Connect(function()
    if State.NoclipAktif and LP.Character then
        for _, v in pairs(LP.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
        end
    end
end)

-- Yürüme Hızı
RunService.RenderStepped:Connect(function()
    if LP.Character and LP.Character:FindFirstChild("Humanoid") then
        LP.Character.Humanoid.WalkSpeed = State.Hiz
    end
end)

-- Hitbox
RunService.RenderStepped:Connect(function()
    for _, oyuncu in pairs(Players:GetPlayers()) do
        if oyuncu ~= LP and oyuncu.Character and oyuncu.Character:FindFirstChild("HumanoidRootPart") then
            if State.HitboxAktif then
                oyuncu.Character.HumanoidRootPart.Size = Vector3.new(State.HitboxBoyutu, State.HitboxBoyutu, State.HitboxBoyutu)
                oyuncu.Character.HumanoidRootPart.Transparency = 0.5
                oyuncu.Character.HumanoidRootPart.CanCollide = false
            else
                oyuncu.Character.HumanoidRootPart.Size = Vector3.new(2, 2, 1)
                oyuncu.Character.HumanoidRootPart.Transparency = 1
            end
        end
    end
end)

-- Aimbot
RunService.RenderStepped:Connect(function()
    if State.AimbotAktif and LP.Character and LP.Character:FindFirstChild("Head") then
        local enYakin, enKisaMesafe = nil, math.huge
        for _, oyuncu in pairs(Players:GetPlayers()) do
            if oyuncu ~= LP and oyuncu.Character and oyuncu.Character:FindFirstChild("Head") then
                local mesafe = (oyuncu.Character.Head.Position - LP.Character.Head.Position).Magnitude
                if mesafe < enKisaMesafe then
                    enKisaMesafe = mesafe
                    enYakin = oyuncu.Character.Head
                end
            end
        end
        if enYakin then
            local kameraPos = workspace.CurrentCamera.CFrame.Position
            workspace.CurrentCamera.CFrame = CFrame.lookAt(kameraPos, enYakin.Position)
        end
    end
end)

