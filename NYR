local function SekmeEkle(isim, ikon, sira)
    local Btn = YeniObje("TextButton", {
        Size = UDim2.new(1, -20, 0, 40), Position = UDim2.new(0, 10, 0, 65 + (sira * 46)),
        BackgroundColor3 = Renkler.SolMenuArka, Text = "", BorderSizePixel = 0, AutoButtonColor = false
