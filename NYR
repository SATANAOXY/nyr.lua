local function SwitchEkle(ebeveyn, isim, aciklama, varsayilan, callback)
    local Kutu = YeniObje("Frame", {
        Size = UDim2.new(1, -10, 0, 52), BackgroundColor3 = Renkler.KutuArka, BorderSizePixel = 0
    }, ebeveyn)
    YeniObje("UICorner", {CornerRadius = UDim.new(0, 8)}, Kutu)

    YeniObje("TextLabel", {
        Size = UDim2.new(0.7, 0, 0, 18), Position = UDim2.new(0, 15, 0, 8),
        BackgroundTransparency = 1, Text = isim, TextColor3 = Renkler.Yazı,
        TextSize = 13, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left
    }, Kutu)

    YeniObje("TextLabel", {
        Size = UDim2.new(0.7, 0, 0, 15), Position = UDim2.new(0, 15, 0, 27),
        BackgroundTransparency = 1, Text = aciklama, TextColor3 = Renkler.GriYazı,
        TextSize = 10, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left
    }, Kutu)

    local Btn = YeniObje("TextButton", {
        Size = UDim2.new(0, 42, 0, 22), Position = UDim2.new(1, -55, 0.5, -11),
        BackgroundColor3 = varsayilan and Renkler.Pembe or Renkler.SwitchKapali, Text = "", BorderSizePixel = 0
    }, Kutu)
    YeniObje("UICorner", {CornerRadius = UDim.new(1, 0)}, Btn)

    local Yuvarlak = YeniObje("Frame", {
        Size = UDim2.new(0, 16, 0, 16), 
        Position = varsayilan and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0
    }, Btn)
    YeniObje("UICorner", {CornerRadius = UDim.new(1, 0)}, Yuvarlak)

    local aktif = varsayilan
    Btn.MouseButton1Click:Connect(function()
        aktif = not aktif
        if aktif then
            TweenService:Create(Btn, TweenInfo.new(0.18), {BackgroundColor3 = Renkler.Pembe}):Play()
            TweenService:Create(Yuvarlak, TweenInfo.new(0.18), {Position = UDim2.new(1, -19, 0.5, -8)}):Play()
        else
            TweenService:Create(Btn, TweenInfo.new(0.18), {BackgroundColor3 = Renkler.SwitchKapali}):Play()
            TweenService:Create(Yuvarlak, TweenInfo.new(0.18), {Position = UDim2.new(0, 3, 0.5, -8)}):Play()
        end
        if callback then callback(aktif) end
    end)
end

