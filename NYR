-- ═══ MOTOR (ÇALIŞAN KODLAR) ═══

-- ESP
RunService.RenderStepped:Connect(function()
    for _, oyuncu in pairs(Players:GetPlayers()) do
        if oyuncu ~= LP and oyuncu.Character then
            local highlight = oyuncu.Character:FindFirstChild("NYR_ESP")
            if State.ESP_Aktif then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "NYR_ESP"
                    highlight.FillColor = Color3.fromRGB(235, 155, 210)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.Parent = oyuncu.Character
                end
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
end)

-- Fly
local flyBaglanti
RunService.RenderStepped:Connect(function()
    if State.FlyAktif and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        if not LP.Character.HumanoidRootPart:FindFirstChild("NYR_Fly") then
            local BV = Instance.new("BodyVelocity", LP.Character.HumanoidRootPart)
            BV.Name = "NYR_Fly"
            BV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            flyBaglanti = RunService.RenderStepped:Connect(function()
                BV.Velocity = Vector3.new(0, 0, 0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then BV.Velocity = BV.Velocity + workspace.CurrentCamera.CFrame.LookVector * 50 end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then BV.Velocity = BV.Velocity - workspace.CurrentCamera.CFrame.LookVector * 50 end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then BV.Velocity = BV.Velocity - workspace.CurrentCamera.CFrame.RightVector * 50 end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then BV.Velocity = BV.Velocity + workspace.CurrentCamera.CFrame.RightVector * 50 end
            end)
        end
    elseif not State.FlyAktif and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        if LP.Character.HumanoidRootPart:FindFirstChild("NYR_Fly") then
            LP.Character.HumanoidRootPart.NYR_Fly:Destroy()
        end
        if flyBaglanti then flyBaglanti:Disconnect() end
    end
end)

-- Noclip
RunService.Stepped:Connect(function()
    if State.NoclipAktif and LP.Character then
        for _, v in pairs(LP.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
        end
    end
end)

-- Hız
RunService.RenderStepped:Connect(function()
    if LP.Character and LP.Character:FindFirstChild("Humanoid") then
        if State.HizAktif then
            LP.Character.Humanoid.WalkSpeed = 100
        else
            LP.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

-- Hitbox
RunService.RenderStepped:Connect(function()
    for _, oyuncu in pairs(Players:GetPlayers()) do
        if oyuncu ~= LP and oyuncu.Character and oyuncu.Character:FindFirstChild("HumanoidRootPart") then
            if State.HitboxAktif then
                oyuncu.Character.HumanoidRootPart.Size = Vector3.new(10, 10, 10)
                oyuncu.Character.HumanoidRootPart.Transparency = 0.5
                oyuncu.Character.HumanoidRootPart.CanCollide = false
            else
                oyuncu.Character.HumanoidRootPart.Size = Vector3.new(2, 2, 1)
                oyuncu.Character.HumanoidRootPart.Transparency = 1
            end
        end
    end
end)

-- Aimbot
RunService.RenderStepped:Connect(function()
    if State.AimbotAktif and LP.Character and LP.Character:FindFirstChild("Head") then
        local enYakin, enKisaMesafe = nil, math.huge
        for _, oyuncu in pairs(Players:GetPlayers()) do
            if oyuncu ~= LP and oyuncu.Character and oyuncu.Character:FindFirstChild("Head") then
                local mesafe = (oyuncu.Character.Head.Position - LP.Character.Head.Position).Magnitude
                if mesafe < enKisaMesafe then
                    enKisaMesafe = mesafe
                    enYakin = oyuncu.Character.Head
                end
            end
        end
        if enYakin then
            local kameraPos = workspace.CurrentCamera.CFrame.Position
            workspace.CurrentCamera.CFrame = CFrame.lookAt(kameraPos, enYakin.Position)
        end
    end
end)

-- Auto Grab Gun
task.spawn(function()
    while true do
        task.wait(0.5)
        if State.AutoGunAktif then
            local silah = workspace:FindFirstChild("GunDrop") or workspace:FindFirstChild("Revolver")
            if silah and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                LP.Character.HumanoidRootPart.CFrame = silah.CFrame
            end
        end
    end
end)

