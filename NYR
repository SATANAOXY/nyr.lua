local function SwitchEkle(ebeveyn, isim, aciklama, varsayilan, callback)
    local Kutu = Instance.new("Frame")
    Kutu.Size = UDim2.new(1, -10, 0, 48)
    Kutu.BackgroundColor3 = Renkler.KutuArka
    Kutu.BorderSizePixel = 0
    Kutu.Parent = ebeveyn

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 6)
    boxCorner.Parent = Kutu

    local NameLbl = Instance.new("TextLabel")
    NameLbl.Size = UDim2.new(0.7, 0, 0, 16)
    NameLbl.Position = UDim2.new(0, 12, 0, 8)
    NameLbl.BackgroundTransparency = 1
    NameLbl.Text = isim
    NameLbl.TextColor3 = Renkler.Yazı
    NameLbl.TextSize = 12
    NameLbl.Font = Enum.Font.GothamBold
    NameLbl.TextXAlignment = Enum.TextXAlignment.Left
    NameLbl.Parent = Kutu

    local DescLbl = Instance.new("TextLabel")
    DescLbl.Size = UDim2.new(0.7, 0, 0, 14)
    DescLbl.Position = UDim2.new(0, 12, 0, 24)
    DescLbl.BackgroundTransparency = 1
    DescLbl.Text = aciklama
    DescLbl.TextColor3 = Renkler.GriYazı
    DescLbl.TextSize = 9
    DescLbl.Font = Enum.Font.Gotham
    DescLbl.TextXAlignment = Enum.TextXAlignment.Left
    DescLbl.Parent = Kutu

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 38, 0, 20)
    Btn.Position = UDim2.new(1, -50, 0.5, -10)
    Btn.BackgroundColor3 = varsayilan and Renkler.Pembe or Renkler.SwitchKapali
    Btn.Text = ""
    Btn.BorderSizePixel = 0
    Btn.Parent = Kutu

    local swCorner = Instance.new("UICorner")
    swCorner.CornerRadius = UDim.new(1, 0)
    swCorner.Parent = Btn

    local Yuvarlak = Instance.new("Frame")
    Yuvarlak.Size = UDim2.new(0, 14, 0, 14)
    Yuvarlak.Position = varsayilan and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
    Yuvarlak.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Yuvarlak.BorderSizePixel = 0
    Yuvarlak.Parent = Btn

    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(1, 0)
    cCorner.Parent = Yuvarlak

    local aktif = varsayilan
    Btn.MouseButton1Click:Connect(function()
        aktif = not aktif
        if aktif then
            TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Renkler.Pembe}):Play()
            TweenService:Create(Yuvarlak, TweenInfo.new(0.15), {Position = UDim2.new(1, -17, 0.5, -7)}):Play()
        else
            TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = Renkler.SwitchKapali}):Play()
            TweenService:Create(Yuvarlak, TweenInfo.new(0.15), {Position = UDim2.new(0, 3, 0.5, -7)}):Play()
        end
        if callback then callback(aktif) end
    end)
end

