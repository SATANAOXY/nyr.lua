local function ToggleOlustur(isim, yPos, callback)
    local Kutu = YeniObje("Frame", {
        Size = UDim2.new(0.48, 0, 0, 35),
        Position = UDim2.new(0, 0, 0, yPos),
        BackgroundColor3 = Color3.fromRGB(30, 30, 40),
        BorderSizePixel = 0
    }, Icerik)
    YeniObje("UICorner", {CornerRadius = UDim.new(0, 6)}, Kutu)

    local Etiket = YeniObje("TextLabel", {
        Size = UDim2.new(0.65, 0, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = isim,
        TextColor3 = Color3.fromRGB(200, 200, 200),
        TextSize = 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Kutu)

    local Buton = YeniObje("TextButton", {
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -50, 0.5, -10),
        BackgroundColor3 = Color3.fromRGB(50, 50, 60),
        Text = "",
        BorderSizePixel = 0
    }, Kutu)
    YeniObje("UICorner", {CornerRadius = UDim.new(1, 0)}, Buton)

    local Yuvarlak = YeniObje("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(180, 180, 180),
        BorderSizePixel = 0
    }, Buton)
    YeniObje("UICorner", {CornerRadius = UDim.new(1, 0)}, Yuvarlak)

    local aktif = false
    Buton.MouseButton1Click:Connect(function()
        aktif = not aktif
        if aktif then
            TweenService:Create(Buton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80, 200, 120)}):Play()
            TweenService:Create(Yuvarlak, TweenInfo.new(0.2), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
            Etiket.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            TweenService:Create(Buton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 60)}):Play()
            TweenService:Create(Yuvarlak, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
            Etiket.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        callback(aktif)
    end)
end

local function SliderOlustur(isim, yPos, min, max, varsayilan, callback)
    local Kutu = YeniObje("Frame", {
        Size = UDim2.new(0.48, 0, 0, 35),
        Position = UDim2.new(0.52, 0, 0, yPos),
        BackgroundColor3 = Color3.fromRGB(30, 30, 40),
        BorderSizePixel = 0
    }, Icerik)
    YeniObje("UICorner", {CornerRadius = UDim.new(0, 6)}, Kutu)

    local Etiket = YeniObje("TextLabel", {
        Size = UDim2.new(0.6, 0, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = isim .. ": " .. varsayilan,
        TextColor3 = Color3.fromRGB(200, 200, 200),
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Kutu)

    local Kaydirici = YeniObje("TextButton", {
        Size = UDim2.new(0, 60, 0, 22),
        Position = UDim2.new(1, -70, 0.5, -11),
        BackgroundColor3 = Color3.fromRGB(45, 45, 55),
        Text = tostring(varsayilan),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        BorderSizePixel = 0
    }, Kutu)
    YeniObje("UICorner", {CornerRadius = UDim.new(0, 4)}, Kaydirici)

    local deger = varsayilan
    Kaydirici.MouseButton1Click:Connect(function()
        deger = deger + 5
        if deger > max then deger = min end
        Kaydirici.Text = tostring(deger)
        Etiket.Text = isim .. ": " .. deger
        callback(deger)
    end)
end

