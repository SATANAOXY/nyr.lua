local function YeniObje(tur, ozellikler, ebeveyn)
    local obje = Instance.new(tur)
    for k, v in pairs(ozellikler) do
        obje[k] = v
    end
    if ebeveyn then obje.Parent = ebeveyn end
    return obje
end

